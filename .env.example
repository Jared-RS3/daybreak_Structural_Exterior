# Copy to .env.local for local development, and set the same values in your
# host's dashboard (e.g. Vercel → Settings → Environment Variables).
# Never commit real values. Never prefix these with NEXT_PUBLIC_ — that would
# send them to every visitor's browser.

# Airtable personal access token: https://airtable.com/create/tokens
# Scope: data.records:write only. Access: this one base only.
AIRTABLE_TOKEN=
# The base id, starts with "app" (it's in the base's URL).
AIRTABLE_BASE_ID=
# Table name or id. Defaults to "Leads".
AIRTABLE_TABLE=
# The live tools' homeowner leads (crack checker and house estimator), in the
# same base. Defaults to "Homeowner Leads". Create it with:
#   AIRTABLE_SETUP_TOKEN=... node scripts/airtable-setup.mjs
AIRTABLE_TOOL_TABLE=

# Emails the PDF to the homeowner, through Resend (resend.com).
# API key with "Sending access" only.
RESEND_API_KEY=
# Who it's from. The domain must be verified in Resend (Domains → Add) before
# it can send to anyone but the Resend account's own address.
EMAIL_FROM=
# Optional: where homeowners' replies go.
EMAIL_REPLY_TO=

# Optional. Signs the token the lead form fetches when it appears, which is
# how the server knows a submit wasn't sent instantly by a script. Without
# it, the Airtable token is used as the key. Any long random string, e.g.
# the output of: openssl rand -base64 32
LEAD_FORM_SECRET=

# Cloudflare Turnstile, the "are you a person?" check on both forms. Free:
# Cloudflare dashboard → Turnstile → Add widget, mode "Managed", with this
# site's domain (and localhost for development). The site key is public by
# design (it's built into the pages, so redeploy after setting it); the
# secret key is not. Set both or neither: with either empty, the check is off.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX (GA → Admin → Data
# streams → your stream). Not a secret: Google's tag puts it in every page, so
# this one is meant to carry NEXT_PUBLIC_. Leave it empty and the site sets no
# analytics cookies, shows no cookie banner, and the privacy policy says so.
# It's built into the pages, so redeploy after setting or changing it.
NEXT_PUBLIC_GA_ID=
